{
  "name": "ai-browser",
  "productName": "AI浏览器",
  "version": "3.0.0",
  "description": "AI 浏览器 — Electron (Chromium) + AI 搜索/词典/GeoGebra",
  "main": "src/main/main.js",
  "author": "Felix",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run-tests.js",
    "stage:mac": "node scripts/stage-mac.js",
    "pack:mac": "node scripts/pack-mac.js",
    "dist:mac": "npm run pack:mac",
    "test:direct": "node test/run-all.js",
    "dist:win": "node scripts/pack-win.js x64",
    "dist:win-arm64": "node scripts/pack-win.js arm64"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^45.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.6.1",
    "js-mdict": "^6.0.8",
    "jsdom": "^29.1.1",
    "node-llama-cpp": "^3.22.2"
  },
  "build": {
    "appId": "com.felix.aibrowser",
    "productName": "AI Browser",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
